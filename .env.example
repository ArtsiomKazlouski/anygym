# ---------------------------------------------------------------------------
# База. Локально подтягивается командой `neon link`, на Vercel — интеграцией Neon.
# DATABASE_URL          — пулленное соединение, его использует приложение
# DATABASE_URL_UNPOOLED — прямое соединение, его использует drizzle-kit для DDL
# ---------------------------------------------------------------------------
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------
# Auth.js. Секрет генерируется командой: npx auth secret
# ---------------------------------------------------------------------------
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Google OAuth. Создаётся вручную в Google Cloud Console:
#   APIs & Services -> Credentials -> Create OAuth client ID -> Web application
# Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
#   https://<домен>/api/auth/callback/google
# ---------------------------------------------------------------------------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Кого пускаем. Через запятую. ПУСТОЙ СПИСОК = НЕ ПУСКАЕМ НИКОГО.
# ---------------------------------------------------------------------------
ALLOWED_EMAILS=
